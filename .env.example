# .env — machine-specific overrides and secrets
# This file is NOT committed to git (.gitignore excludes it).
# Copy this to .env and fill in your values.
# All values here override config/config.yaml at runtime.

# Ollama host (if not running on default localhost)
# OLLAMA_HOST=http://localhost:11434

# Piper paths — only needed if your Piper install is outside the project root
# PIPER_EXE=C:\Users\white\PocketAI\piper\piper.exe
# PIPER_MODEL=C:\Users\white\PocketAI\piper\voices\en_US-lessac-medium.onnx

# Future: API keys go here when web search (4h) is added
# TAVILY_API_KEY=your_key_here
